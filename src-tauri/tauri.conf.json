{
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "https://localhost:3000/RIP-frontend/",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Calculator App",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": true,
      "http": {
        "all": true,
        "request": true,
        "scope": [
          "https://localhost:3000/**",
          "https://192.168.1.50:3000/**"
        ]
      }
    },
    "bundle": {
      "active": false,
      "identifier": "com.calculator.app"
    },
    "security": {
      "csp": "default-src 'self' http: https: ws: wss: data: blob: 'unsafe-inline' 'unsafe-eval'"
    },
    "windows": [
      {
        "height": 600,
        "resizable": true,
        "title": "Calculator App",
        "width": 800
      }
    ]
  }
}